{
	"name": "rosace-gui",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"build-debug": "x4build --watch --hmr --serve src/main.ts",
		"build": "x4build"
	},
	"devDependencies": {
		"x4build": "latest",
		"x4js": "latest"
	},
	"dependencies": {
		"@fontsource/montserrat": "^5.1"
	},
	"x4build": {
		"copy": [
			{ "from": "src/assets", "to": "assets" },
			{ "from": "src/index.html", "to": "index.html" }
		]
	}

}