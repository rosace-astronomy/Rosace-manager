{
  "name": "rosace-gui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.ts --bundle --outfile=bundle.js --minify --keep-names --sourcemap --loader:.scss=empty --loader:.svg=dataurl",
    "dev":   "esbuild src/main.ts --bundle --outfile=bundle.js --watch --keep-names --sourcemap --loader:.scss=empty --loader:.svg=dataurl"
  },
  "devDependencies": {
    "esbuild": "latest"
  }
}
