{
	"name": "rosace-gui",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"build-debug": "x4build --watch --hmr --serve src/main.ts",
		"build": "x4build"
	},
	"devDependencies": {
		"x4build": "latest",
		"x4js": "latest"
	},
	"dependencies": {
		"@fontsource/montserrat": "^5.2.8",
		"montserrat": "^1.0.1"
	},
	"x4build": {
		"copy": [
			{
				"from": "src/assets",
				"to": "assets"
			},
			{
				"from": "src/index.html",
				"to": "index.html"
			},
			{
				"from": "src/be_validation.html",
				"to": "be/index.html"
			}
		],
		"entryPoints": [
			"src/main.ts",
			"src/be_validation.ts"
		]
	},
	"allowScripts": {
		"@parcel/watcher@2.5.6": true,
		"esbuild": true
	}
}
